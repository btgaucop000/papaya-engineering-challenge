{
  "name": "papaya-claims-workflow-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:api && npm run build:ui",
    "build:api": "tsc -p tsconfig.json",
    "build:ui": "vite build --config challenge/frontend/vite.config.ts",
    "dev:ui": "vite --config challenge/frontend/vite.config.ts",
    "dev:ui:e2e": "vite --config challenge/frontend/vite.e2e.config.ts",
    "preview:ui": "vite preview --config challenge/frontend/vite.config.ts",
    "start:api": "npm run build:api && node dist/challenge/src/api/main.js",
    "start:api:e2e": "npm run build:api && node challenge/e2e/start-api-e2e.mjs",
    "demo:seed": "npm run build:api && node dist/challenge/src/api/seed-demo.js",
    "test": "npm run test:unit",
    "test:unit": "npm run build:api && node --test dist/challenge/test/config-loader.test.js dist/challenge/test/workflow-engine.test.js",
    "test:integration": "npm run db:test:setup && node --test --test-concurrency=1 dist/challenge/test/persistence.integration.test.js dist/challenge/test/api.integration.test.js",
    "test:api": "npm run db:test:setup && node --test dist/challenge/test/api.integration.test.js",
    "db:migrate": "npm run build:api && node dist/challenge/src/persistence/migrate.js",
    "db:test:setup": "npm run build:api && node dist/challenge/src/persistence/create-test-database.js && node dist/challenge/src/persistence/migrate.js --test",
    "test:ui:e2e": "playwright test",
    "typecheck": "npm run typecheck:api && npm run typecheck:ui",
    "typecheck:api": "tsc -p tsconfig.json --noEmit",
    "typecheck:ui": "tsc -p challenge/frontend/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.16.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
