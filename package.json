{
  "name": "papaya-claims-workflow-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run test:unit",
    "test:unit": "npm run build && node --test dist/challenge/test/config-loader.test.js dist/challenge/test/workflow-engine.test.js",
    "test:integration": "npm run db:test:setup && node --test dist/challenge/test/persistence.integration.test.js",
    "db:migrate": "npm run build && node dist/challenge/src/persistence/migrate.js",
    "db:test:setup": "npm run build && node dist/challenge/src/persistence/create-test-database.js && node dist/challenge/src/persistence/migrate.js --test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.16.1",
    "@types/pg": "^8.23.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
